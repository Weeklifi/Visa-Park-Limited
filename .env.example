DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/visapark
REDIS_URL=redis://localhost:6379/0

# Dev default is HS256 with a shared secret below. For production, generate an
# RSA key pair and switch JWT_ALGORITHM to RS256 per NFR 5.3.
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=change-me-dev-only-secret
JWT_PUBLIC_KEY=change-me-dev-only-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
